# Copier ce fichier en .env.local (développement) ou renseigner ces variables
# dans le panneau de votre hébergeur (Netlify, Vercel, Cloudflare Pages…).
# Toute variable exposée au navigateur doit commencer par VITE_.

# URL publique du site : sert au lien canonique et au sitemap.
VITE_SITE_URL=https://kodafrik.com

# Service qui reçoit les demandes du formulaire de contact.
# Laisser vide : le formulaire ouvre le client mail du visiteur (aucun envoi
# automatique, le visiteur doit cliquer sur « Envoyer » dans sa messagerie).
#
# Option A — Web3Forms (https://web3forms.com, gratuit, sans compte) :
#   créez une clé avec contact@kodafrik.com, puis :
#   VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit
#   VITE_CONTACT_ACCESS_KEY=votre-cle-daccess
#
# Option B — Formspree (https://formspree.io) :
#   VITE_CONTACT_ENDPOINT=https://formspree.io/f/votre-identifiant
#   (VITE_CONTACT_ACCESS_KEY inutile)
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_ACCESS_KEY=
